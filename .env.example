# Copy to .env and fill in. .env is git-ignored: no credential belongs in this repository.

# ---------------------------------------------------------------- the site
PASSPORT_SERVER_URL=http://localhost:8080
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=AI4HF-Authorization

# Which study this node contributes to, and which organization it speaks for.
STUDY_ID=
ORGANIZATION_ID=

# ---------------------------------------------------------------- identities
# One Keycloak service account per module, so the Passport's audit log book can tell which module
# made a change. Each account must be a member of its study group with the role its writes need:
#
#   dataset-sync        DATA_ENGINEER
#   metadata-publisher  DATA_STEWARD
#   monitoring-import   DATA_SCIENTIST

DATASET_SYNC_CLIENT_ID=ai4hf-node-agent-dataset-sync
DATASET_SYNC_CLIENT_SECRET=

METADATA_PUBLISHER_CLIENT_ID=ai4hf-node-agent-metadata-publisher
METADATA_PUBLISHER_CLIENT_SECRET=

MONITORING_IMPORT_CLIENT_ID=ai4hf-node-agent-monitoring-import
MONITORING_IMPORT_CLIENT_SECRET=

# ---------------------------------------------------------------- dataset-sync
FEAST_URL=http://localhost:8086/onfhir-feast/api
DATASET_ID=
EXPERIMENT_ID=

# Optional: run these quality criteria over the dataset and record the assessment.
QUALITY_CRITERIA_IDS=
# The definitions release this node runs, so the criteria rules can be read. Studyfyr does not serve
# quality criteria definitions over REST.
DEFINITIONS_DIR=

# ---------------------------------------------------------------- metadata-publisher
FDP_URL=
FDP_CATALOG_ID=
FDP_TOKEN=

# ---------------------------------------------------------------- monitoring-import
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=evaluation-measures-*
ELASTICSEARCH_BASIC_AUTH=

# ---------------------------------------------------------------- misc
REQUEST_TIMEOUT_SECONDS=60
